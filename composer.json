{
  "name": "teqnomaze/php-skeleton",
  "description": "A template for kick-starting the development of a standards-compliant PHP library/package with all the development tools.",
  "keywords": [
    "skeleton",
    "package",
    "boilerplate"
  ],
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11",
    "squizlabs/php_codesniffer": "^4.0",
    "teqnomaze/code-coverage": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Teqnomaze\\Skeleton\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Teqnomaze\\Skeleton\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "phpcs": "./vendor/bin/phpcs --standard=phpcs.xml",
    "phpcbf": "./vendor/bin/phpcbf --standard=phpcs.xml",
    "phpstan": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
    "phpunit": "./vendor/bin/phpunit --configuration phpunit.xml",
    "coverage": "./vendor/bin/code-coverage ./build/clover.xml 95"
  }
}
